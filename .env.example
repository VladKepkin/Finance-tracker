# Секрет для підпису JWT сесії (мінімум 16 символів, згенерувати: openssl rand -hex 32)
SESSION_SECRET=

# Ключ шифрування токенів Monobank AES-256-GCM (строго 32 байти / 64 hex символи: openssl rand -hex 32)
ENCRYPTION_KEY=

# Початковий адміністратор (створюється при першому старті бази, якщо ще не існує)
APP_USERNAME=admin
APP_PASSWORD=

# Системні налаштування
DATABASE_PATH=/app/data/money.db
NODE_ENV=production
PORT=3000

# Опціональний токен авторизації для збору метрик Prometheus (/api/metrics/prometheus?token=...)
METRICS_TOKEN=
